{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "OpenTelemetry.Exporter": "Error",
      "System.Net.Http.HttpClient.OtlpMetricExporter": "Error"
    }
  },
  "Bioreference.LIS": {
    "Instance": "B2",
    "LimitDayRange": 2920,
    "ReleaseOnDemographicUpdate": true,
    "ToFollowEnabled": false,
    "urlBase": "https://b24kapi.bioreference.com/",
    "4KUrlBase": "https://b24kapi.bioreference.com/",
    "DisableAutoReleaseWithAlerts": "True",
    "BypassCatOnDemoUpdate": [ "TOXICOLOGY" ]
  },
  "Bioreference.Data.Client": {
    "CommandTimeout": "120"
  },
  "Bioreference.Security": {
    "ActiveDirectoryService": "http://NJ1LISP1.bioreference-laboratories.com/activedirectoryservices/Service.asmx"
  },
  "Bioreference.Data.Security": {
    "DisableAutoDatabaseAuthentication": "True"
  }
}
