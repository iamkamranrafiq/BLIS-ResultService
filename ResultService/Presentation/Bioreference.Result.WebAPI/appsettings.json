{  
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "OpenTelemetry.Exporter": "Error",
      "System.Net.Http.HttpClient.OtlpMetricExporter": "Error"
    }
  },
  "Bioreference.TestMaster.Common": {
    "CachedEnabled": "true",
    "CachedTestExpirationMinutes": "60",
    "CachedTestSlidingMinutes": "10",
    "CachedTestSizeLimit": "1000"
  },
  "Bioreference.LIS": {
    "Instance": "",
    "LimitDayRange": 60,
    "ReleaseOnDemographicUpdate": false,
    "DemographicUpdateAutoCommentCode": 1064,
    "AddTestFromTestMaster": true,
    "DefaultDivisionCode": [
      "NJ1",
      "NJ01"
    ],
    "ThrowExeptionForCurrentFinal": false,
    "ToFollowEnabled": false,
    "PreliminaryCommentToRemove": "NOTE: The initial automated WBC differential suggested a potential abnormal finding. Results of a manual smear review by a pathologist will be provided on a subsequent final report.",
    //note: urlBase is used by the 4K calculator proxy. it probably will not work here until the proxy is rewritten to use appsettings.json
    "urlBase": "https://b24kapiqa.bioreference.com/",
    "UserName": "b2_app",
    "RuleSetRelease": "1",
    "RuleSetChangeResult": "2",
    "AutoRefreshPendings": "False",
    "AutoRefreshPendingsMinutes": "4",
    "4KUrlBase": "https://b24kapiqa.bioreference.com/",
    "MessageProducer": [
      {
        "Topic": "results.di-result.received",
        "MessageType": "UnsolicitedMessage"
      }
    ]

  },
  "Bioreference.Data.Audit": {
    "DisableAudit": "False",
    "BypassAuditSave": "False"
  },
  "Bioreference.Data.Client": {
    "SuppressErrors": "False",
    "CommandTimeout": "60"
  },
  "Bioreference.Data": {
    "UseRemoteFactory": "False",
    "SuppressConcurrencyException": "False",
    "Logging": {
      "LogLevel": "1"
    },
    "Web": {
      "DataFactoryService": "http://NJ1LISU01/BRLIWebServices/DataFactory.asmx"
    }
  },
  "Bioreference.Security": {
    "ActiveDirectoryService": "http://NJ1LISU01/ActiveDirectoryServices/Service.asmx"
  },
  "Bioreference.Order": {
    "ConcurrencyEnabled": "True"
  },
  "Bioreference.Data.Security": {
    "DisableAutoDatabaseAuthentication": "False"
  },
  "Bioreference.Utilities": {
    "ErrorFolder": "c:/errors/spm/"
  },
  "Bioreference.RuleEngine": {
    "DisableEvaluation": "False"
  },
  "Bioreference.QueueOrderInProcessor": {
    "AOEExclusionList": [ "O019", "O020", "O021", "O022", "O023", "O024", "0305", "A501", "O006" ],
    "AltHoldCodes": "NSRA,RTDA,STFA"
  },
  "Producers": {
    "Servers": "kafka-broker.kafka.svc.cluster.local:9092",
    "KafkaApiBaseUrl": "kafka-broker.kafka.svc.cluster.local:9092/api/",
    "MessageChunkSizeKb": 600,
    "ProducersList": [
      {
        "ModelName": "Bioreference.Contracts.Result.Incident",
        "Topic": "incidents.revised-result.generated",
        "KafkaLogTopicName": "KafkaLog.Topic",
        "CustomHeaders": [
          {
            "Key": "Application",
            "Value": "ResultService"
          }
        ]
      },
      {
        "ModelName": "Bioreference.Contracts.Result.Reflex",
        "Topic": "results.reflex.generated",
        "KafkaLogTopicName": "KafkaLog.Topic",
        "CustomHeaders": [
          {
            "Key": "Application",
            "Value": "ResultService"
          }
        ]
      },
      {
        "ModelName": "Bioreference.Contracts.Result.AuditOut",
        "Topic": "results.audit-message.generated",
        "KafkaLogTopicName": "KafkaLog.Topic",
        "CustomHeaders": [
          {
            "Key": "Application",
            "Value": "ResultService"
          }
        ]
      }
    ]
  }
}