<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<RootNamespace>Bioreference.ScanningService.Jobs</RootNamespace>
	<AssemblyName>Bioreference.ScanningService.Jobs</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bioreference.Jobs.Core" Version="1.1.0" />
    <PackageReference Include="BioReference.Logging" Version="10.1.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\Bioreference.ScanningService.Application\Bioreference.ScanningService.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Bioreference.ScanningService.Infrastructure\Bioreference.ScanningService.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Jobs\IngestDocs\appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Jobs\IngestDocs\appsettings.*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
