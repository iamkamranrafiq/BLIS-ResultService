<Project Sdk="WixToolset.Sdk/5.0.2">

	<PropertyGroup>
		<OutputType>Package</OutputType>
		<OutputName>Bioreference.ScanningService.Installer</OutputName>
		<InstallerPlatform>x64</InstallerPlatform>
		<!-- Path to the published Windows Service output. Override with: dotnet build
		-p:ServicePublishDir=... -->
		<ServicePublishDir Condition="'$(ServicePublishDir)' == ''">
			$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\WindowsService\Bioreference.ScanningService.WinService\bin\Release\net10.0-windows\win-x64\publish\'))</ServicePublishDir>
		<!-- MSI ProductVersion (Major.Minor.Build). CI passes -p:ProductVersion=x.y.z; must increase for MajorUpgrade. -->
		<ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
		<!-- Host environment the service runs under (Development | QA | Stage | Production). -->
		<ServiceEnvironment Condition="'$(ServiceEnvironment)' == ''">Production</ServiceEnvironment>
		<DefineConstants>PublishDir=$(ServicePublishDir);ProductVersion=$(ProductVersion);ServiceEnvironment=$(ServiceEnvironment)</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
	</ItemGroup>

</Project>