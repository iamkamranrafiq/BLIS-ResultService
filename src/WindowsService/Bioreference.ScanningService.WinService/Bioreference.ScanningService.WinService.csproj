		<PackageReference Include="Microsoft.OpenApi" Version="1.6.22" />
		<PackageReference Include="NTwain" Version="3.7.5" />
		<PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference
			Include="..\..\Application\Bioreference.ScanningService.Application\Bioreference.ScanningService.Application.csproj" />
		<ProjectReference
			Include="..\..\Infrastructure\Bioreference.ScanningService.Infrastructure\Bioreference.ScanningService.Infrastructure.csproj" />
	</ItemGroup>

</Project>